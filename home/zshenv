# ~/.zshenv — installed at $HOME by bin/install.sh; symlink target = ~/zsh/home/zshenv
#
# Sole purpose:
#   1. Define XDG paths.
#   2. Point zsh at $XDG_CONFIG_HOME/zsh for every other config file.
#   3. Prime $PATH with Homebrew so login + non-interactive shells see /opt/homebrew/bin.
#
# Everything else lives under $ZDOTDIR. Do NOT add interactive niceties here; this file
# is sourced for *every* zsh invocation, including scripts.

: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${XDG_DATA_HOME:=$HOME/.local/share}"
: "${XDG_STATE_HOME:=$HOME/.local/state}"
: "${XDG_CACHE_HOME:=$HOME/.cache}"
export XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME

export ZDOTDIR="$XDG_CONFIG_HOME/zsh"

# Prime Homebrew unless it's already been primed by an ancestor shell. This file runs for
# EVERY zsh invocation (incl. every script/subshell); gating on HOMEBREW_PREFIX (which
# `brew shellenv` exports) means the first shell pays ~50ms once and children inherit it
# and skip the subprocess. Don't gate on a PATH substring: /usr/local/bin is always in the
# macOS default PATH, so that check skipped brew shellenv entirely — leaving /opt/homebrew/bin
# stuck at the tail (after /usr/bin, via /etc/paths.d/homebrew) and HOMEBREW_PREFIX unset.
if [[ -z "$HOMEBREW_PREFIX" ]]; then
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi
