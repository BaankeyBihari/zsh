# Copy this to ~/.config/zsh/99-local.zsh (no .example suffix) to add machine-specific or
# secret config. It lives at the ZDOTDIR root — OUTSIDE zsh.d/ — so install.sh never purges
# it when it rebuilds the fragment directory. It is gitignored and sourced LAST, after every
# zsh.d/ fragment, so it can override any of them.
#
# Examples:
#
# export ANTHROPIC_API_KEY="sk-…"
# alias work='cd ~/work/this-machine-only'
# path=(/Users/me/some/work/path $path) && export PATH
# eval "$(direnv hook zsh)"
